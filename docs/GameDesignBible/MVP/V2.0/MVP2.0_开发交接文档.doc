                    </w:WordDocument>
                </xml>
                <![endif]-->
                <style>
                    body { background: #ffffff; color: #1e2a3a; font-family: 'Segoe UI', Arial, sans-serif; max-width: 1100px; margin: 40px auto; padding: 0 30px; line-height: 1.6; }
                    h1, h2, h3, h4 { color: #0b1a33; margin-top: 1.8em; border-bottom: 1px solid #e0e7ef; padding-bottom: 0.3em; }
                    h1 { font-size: 2.2em; border-bottom: 3px solid #1a5cff; text-align: center; }
                    h2 { font-size: 1.7em; border-bottom-width: 2px; }
                    h3 { font-size: 1.3em; border-bottom: none; }
                    h4 { font-size: 1.1em; border-bottom: none; }
                    table { width: 100%; border-collapse: collapse; margin: 20px 0; }
                    th, td { border: 1px solid #d0d8e0; padding: 10px 14px; vertical-align: top; }
                    th { background: #eef3f8; }
                    .footnote { background: #f0f6ff; border-left: 5px solid #1a5cff; padding: 12px 20px; margin: 20px 0; }
                    .status-done { color: #00a854; font-weight: 700; }
                    .status-pending { color: #ff8c00; font-weight: 700; }
                    .highlight-box { background: #f7faff; border: 1px solid #c0d0e0; padding: 14px 18px; margin: 12px 0; }
                    .flow-chart { background: #f7faff; border: 1px solid #d0d8e0; padding: 16px 20px; font-family: monospace; font-size: 0.9rem; line-height: 1.8; margin: 16px 0; }
                    .doc-ref { background: #f7faff; border: 1px solid #d0d8e0; padding: 12px 16px; margin: 8px 0; }
                    .doc-ref .title { font-weight: 700; color: #0b1a33; }
                    .doc-ref .path { color: #5a6a7a; font-family: monospace; font-size: 0.9rem; }
                    .doc-ref .desc { color: #5a6a7a; font-size: 0.9rem; }
                    ul, ol { padding-left: 24px; margin: 12px 0; }
                    li { margin: 5px 0; }
                    hr { border: 0; border-top: 2px dashed #d0d8e0; margin: 40px 0; }
                    .footer { margin-top: 50px; border-top: 1px solid #d0d8e0; padding-top: 20px; font-size: 0.9rem; color: #5a6a7a; text-align: center; }
                    .download-btn { display: none; }
                    .btn-wrapper { display: none; }
                    .badge { display: inline-block; color: white; padding: 2px 12px; border-radius: 20px; font-size: 0.7rem; margin-right: 4px; }
                    .badge-done { background: #00a854; }
                    .badge-pending { background: #ff8c00; }
                </style>
            </head>
            <body>
                ${document.body.innerHTML.replace(/<div class="btn-wrapper">.*?<\/div>/, '')}
            </body>
            </html>`;
            var blob = new Blob([fullHtml], { type: 'application/msword' });
            var link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = 'MVP2.0_开发交接文档.doc';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            URL.revokeObjectURL(link.href);
        }
    </script>



            </body>
            </html>