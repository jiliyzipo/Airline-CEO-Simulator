                    <tr><td>内部危机</td><td>5</td><td>飞行员罢工、核心高管跳槽、AOG连锁</td></tr>
                    <tr><td>政策变化</td><td>5</td><td>航权开放、碳税加征、宵禁延长</td></tr>
                </tbody>
            </table>
