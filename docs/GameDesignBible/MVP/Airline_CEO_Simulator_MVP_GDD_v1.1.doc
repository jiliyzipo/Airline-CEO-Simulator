            <table>
                <thead><tr><th>阶段</th><th>GDP增速</th><th>需求影响</th><th>油价趋势</th><th>本币汇率</th></tr></thead>
                <tbody>
                    <tr><td>繁荣期</td><td>&gt;3%</td><td>+20%</td><td>震荡上涨</td><td>升值</td></tr>
                    <tr><td>衰退期</td><td>&lt;0%</td><td>−20%</td><td>暴跌</td><td>贬值</td></tr>
                    <tr><td>复苏期</td><td>1~3%</td><td>+10%</td><td>低位</td><td>企稳</td></tr>
                </tbody>
            </table>
        </div>

        <h3>9.2 AI竞争对手（3~5家）</h3>
        <div class="table-wrap">
